<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- processPath / arguments sont complétés par "dotnet publish". -->
      <!-- stdoutLogEnabled : ne passer à true que le temps d'un diagnostic (dossier logs accessible en écriture au pool). -->
      <aspNetCore processPath="dotnet" arguments=".\flightManagerAuth.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <!-- IIS 10+ : masque l'en-tête Server ; limite la taille des requêtes (un login fait < 1 Ko). -->
        <requestFiltering removeServerHeader="true">
          <requestLimits maxAllowedContentLength="16384" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
