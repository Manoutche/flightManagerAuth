<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- .NET 9 n'est plus supporté depuis le 10/11/2026 : passer à net10.0 (LTS) dès que le SDK 10
         et le Hosting Bundle 10 sont installés (poste de dev + serveur IIS). -->
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FlightManagerApp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="9.0.0" />
    <PackageReference Include="System.DirectoryServices.Protocols" Version="9.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Le fichier d'exemple ne doit pas partir en production. -->
    <Content Update="appsettings.Production.example.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
