<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- .NET 10 LTS (support jusqu'en novembre 2028). Le serveur IIS doit avoir le Hosting Bundle 10. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FlightManagerApp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="10.0.15" />
    <PackageReference Include="System.DirectoryServices.Protocols" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <!-- Le fichier d'exemple ne doit pas partir en production. -->
    <Content Update="appsettings.Production.example.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
