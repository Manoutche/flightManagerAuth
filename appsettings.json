{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ldap": {
    "Domain": "",
    "Server": "",
    "Port": 636,
    "UseSsl": true,
    "TimeoutSeconds": 10,
    "IncludeUserDetails": true
  },
  "Security": {
    "RequireHttps": true,
    "MaxFailuresPerUser": 5,
    "FailureWindowMinutes": 15,
    "RequestsPerClientPerMinute": 120,
    "ApiClients": []
  }
}
